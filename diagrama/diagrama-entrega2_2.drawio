<mxCell id="g_proxy" value="&lt;b&gt;Worker  trabaidafacul-proxy&lt;/b&gt;&lt;br/&gt;requisicao_front · requisicao_api&lt;br/&gt;origem_indisponivel · erro_proxy" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E8F1F8;strokeColor=#2F6F9F;fontColor=#1E262E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="68" y="180" width="304" height="128" as="geometry"/></mxCell>
<mxCell id="g_api" value="&lt;b&gt;Worker  trabaidafacul-api&lt;/b&gt;&lt;br/&gt;operacao_negocio&lt;br/&gt;consulta_banco · erro_api" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E8F1F8;strokeColor=#2F6F9F;fontColor=#1E262E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="68" y="344" width="304" height="128" as="geometry"/></mxCell>
<mxCell id="g_mon" value="&lt;b&gt;Worker  trabaidafacul-monitor&lt;/b&gt;&lt;br/&gt;Cron Trigger: 1 por minuto&lt;br/&gt;checa app. e api./health&lt;br/&gt;checagem_disponibilidade" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E8F1F8;strokeColor=#2F6F9F;fontColor=#1E262E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="68" y="508" width="304" height="152" as="geometry"/></mxCell>
<mxCell id="c_console" value="&lt;b&gt;console.log (JSON)&lt;/b&gt;&lt;br/&gt;Coleta do proprio provedor&lt;br/&gt;Campos do JSON indexados&lt;br/&gt;Sem custo e sem agente" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ECE9F5;strokeColor=#5A4B8C;fontColor=#1E262E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="468" y="200" width="304" height="152" as="geometry"/></mxCell>
<mxCell id="c_post" value="&lt;b&gt;POST HTTPS 443&lt;/b&gt;&lt;br/&gt;/loki/api/v1/push&lt;br/&gt;Basic Auth (token logs:write)&lt;br/&gt;Lote enviado em ctx.waitUntil,&lt;br/&gt;depois da resposta ao usuario" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ECE9F5;strokeColor=#5A4B8C;fontColor=#1E262E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="468" y="452" width="304" height="184" as="geometry"/></mxCell>
<mxCell id="s_cf" value="&lt;b&gt;Cloudflare Workers Logs&lt;/b&gt;&lt;br/&gt;Retencao: 3 dias (plano free)&lt;br/&gt;Consulta: Query Builder&lt;br/&gt;Papel: conferencia cruzada" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#5A4B8C;fontColor=#1E262E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="868" y="200" width="324" height="152" as="geometry"/></mxCell>
<mxCell id="s_loki" value="&lt;b&gt;Grafana Cloud — Loki&lt;/b&gt;&lt;br/&gt;Retencao: 14 dias (plano free)&lt;br/&gt;Consulta: LogQL&lt;br/&gt;Papel: fonte dos paineis&lt;br/&gt;Stack do grupo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#5A4B8C;fontColor=#1E262E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="868" y="452" width="324" height="184" as="geometry"/></mxCell>
<mxCell id="p_dash" value="&lt;b&gt;Dashboard no Grafana&lt;/b&gt;&lt;br/&gt;1. Disponibilidade pelo dominio&lt;br/&gt;2. Latencia por rota (p50/p95)&lt;br/&gt;3. Erros e bloqueios&lt;br/&gt;4. Uso da aplicacao&lt;br/&gt;5. Banco de dados&lt;br/&gt;6. Redundancia do front" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E0EFE8;strokeColor=#0E6B4F;fontColor=#1E262E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1348" y="200" width="344" height="260" as="geometry"/></mxCell>
<mxCell id="p_acesso" value="&lt;b&gt;Quem pode consultar&lt;/b&gt;&lt;br/&gt;Grafana: login do stack&lt;br/&gt;  (3 usuarios no plano free)&lt;br/&gt;Cloudflare: login da conta&lt;br/&gt;Escrita: token de Access Policy&lt;br/&gt;  limitado a logs:write&lt;br/&gt;Credencial em wrangler secret" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#0E6B4F;fontColor=#1E262E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1348" y="500" width="344" height="220" as="geometry"/></mxCell>
<mxCell id="Observabilidade-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A4B8C;strokeWidth=2;fontColor=#5A4B8C;fontSize=11;dashed=1;dashPattern=2 4;endArrow=block;endFill=1;" edge="1" parent="1" source="g_proxy" target="c_console"><mxGeometry relative="1" as="geometry"/></mxCell>
