                      "spec": {
                        "editorMode": "code",
                        "expr": "quantile_over_time(0.95, {aplicacao=\"trabaidafacul\", servico=\"proxy\"} | json | evento=\"requisicao_api\" | unwrap duracao_ms [$__interval]) by (rota)",
