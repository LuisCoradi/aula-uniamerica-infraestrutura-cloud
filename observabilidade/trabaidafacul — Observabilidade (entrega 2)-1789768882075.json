      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "1b · Checagens por alvo (sucesso x falha)",
          "description": "Mesma fonte do painel 1, separada por alvo e por resultado. Serve para distinguir queda do front de queda da API, e para provar que a ausencia de dados nos outros paineis e ausencia de trafego, nao de coleta.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "grafanacloud-logs"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (alvo) (count_over_time({aplicacao=\"trabaidafacul\", servico=\"monitor\"} | json | evento=\"checagem_disponibilidade\" | ok=\"true\" [$__interval]))",
                        "legendFormat": "{{alvo}} ok",
                        "queryType": "range"
