<mxCell id="dns" value="&lt;b&gt;DNS Cloudflare&lt;/b&gt;&lt;br/&gt;zona trabaidafacul.site&lt;br/&gt;app  -&gt;  Worker (custom domain)&lt;br/&gt;api  -&gt;  Worker (custom domain)&lt;br/&gt;TLS emitido automaticamente" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E8F1F8;strokeColor=#2F6F9F;fontColor=#1E262E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="340" y="140" width="300" height="148" as="geometry"/></mxCell>
<mxCell id="borda" value="&lt;b&gt;Borda Cloudflare (PoP)&lt;/b&gt;&lt;br/&gt;Entrada: HTTPS 443&lt;br/&gt;TLS termina AQUI (min. 1.2)&lt;br/&gt;HTTP 80 -&gt; 301 para HTTPS&lt;br/&gt;WAF: rate limiting por IP&lt;br/&gt;HSTS na resposta" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E8F1F8;strokeColor=#2F6F9F;fontColor=#1E262E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="340" y="372" width="300" height="168" as="geometry"/></mxCell>
<mxCell id="proxy" value="&lt;b&gt;Worker  trabaidafacul-proxy&lt;/b&gt;&lt;br/&gt;Proxy reverso — unico exposto&lt;br/&gt;workers_dev = false&lt;br/&gt;&amp;#160;&lt;br/&gt;app.trabaidafacul.site:&lt;br/&gt;  hash do IP + failover&lt;br/&gt;api.trabaidafacul.site:&lt;br/&gt;  allowlist + CORS" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E8F1F8;strokeColor=#2F6F9F;fontColor=#1E262E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="336" width="300" height="240" as="geometry"/></mxCell>
<mxCell id="regras" value="&lt;b&gt;Bloqueios aplicados no proxy&lt;/b&gt;&lt;br/&gt;Origin != app.trabaidafacul.site&lt;br/&gt;   -&gt; 403&lt;br/&gt;Metodo fora da lista -&gt; 405&lt;br/&gt;Rota fora da lista -&gt; 403&lt;br/&gt;Excesso de requisicoes -&gt; WAF" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FBE9E6;strokeColor=#B3402F;fontColor=#1E262E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="600" width="300" height="196" as="geometry"/></mxCell>
