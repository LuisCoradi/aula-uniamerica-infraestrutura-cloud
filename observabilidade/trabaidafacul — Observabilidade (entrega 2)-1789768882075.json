    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "1 · Disponibilidade pelo dominio",
          "description": "Percentual de checagens do monitor que responderam como esperado. Numerador: checagens com ok=true. Denominador: todas as checagens do periodo. Fonte: Worker trabaidafacul-monitor, uma checagem por minuto em app.trabaidafacul.site e api.trabaidafacul.site/health.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "grafanacloud-logs"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(count_over_time({aplicacao=\"trabaidafacul\", servico=\"monitor\"} | json | evento=\"checagem_disponibilidade\" | ok=\"true\" [$__range])) / sum(count_over_time({aplicacao=\"trabaidafacul\", servico=\"monitor\"} | json | evento=\"checagem_disponibilidade\" [$__range]))",
                        "legendFormat": "disponibilidade",
                        "queryType": "instant"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "colorMode": "background",
                "graphMode": "area",
                "justifyMode": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "textMode": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percentunit",
                  "min": 0,
                  "max": 1,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "red"
                      },
                      {
                        "value": 0.95,
                        "color": "orange"
                      },
                      {
                        "value": 0.99,
                        "color": "green"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
